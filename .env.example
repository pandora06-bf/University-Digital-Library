# Host ports. Change only if one of these ports is already occupied.
BACKEND_PORT=8010
FRONTEND_PORT=5174
POSTGRES_PORT=5433

# Browser frontend -> backend URL. Keep in sync with BACKEND_PORT.
VITE_API_URL=http://localhost:8010

# API container -> PostgreSQL container.
DATABASE_URL=postgresql+psycopg2://lib_user:lib_password@db:5432/libmanager_db

# Development ADMIN account created automatically after migrations.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
# Set true only when you intentionally want to reset the existing admin password.
RESET_ADMIN_PASSWORD=false

# JWT signing key shared by the api and scheduler containers (eBook read_token).
# MUST be a long random secret before any real deployment/demo.
SECRET_KEY=change-this-secret-key

# Dev only: set true to enable the wallet top-up simulation endpoint.
ENABLE_DEV_SIMULATE=false

# Optional SMTP config for JOB-03 due-date reminder emails (scheduler container).
# Leave SMTP_HOST empty to skip sending reminders. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# PDF eBook storage. local = private_storage/ebooks on the API server (default).
# r2 = private Cloudflare R2 bucket; fill the 4 values below (never commit real keys).
# Move existing PDFs: docker exec -w /app libmanager_api python -m scripts.migrate_ebooks_to_r2
STORAGE_BACKEND=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
