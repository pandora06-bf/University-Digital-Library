# false: mọi trang gọi API thật của backend (dùng khi chạy demo / sản phẩm).
# true: MSW trả dữ liệu giả ngay trong trình duyệt (CI, E2E, làm frontend khi chưa có backend).
VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8010

# --- Tuỳ chọn, mặc định TẮT (giao diện sạch, không còn dữ liệu thử) ---
# Ép trang Đặt phòng dùng mock (false) hoặc API (true); bỏ trống thì đi theo VITE_USE_MOCK.
# VITE_ROOM_BOOKING_API=
# Hiện nút "Giả lập chuyển khoản" khi nạp tiền (backend cũng phải bật ENABLE_DEV_SIMULATE=true).
# VITE_ENABLE_TOPUP_SIMULATE=true
# Hiện nút "UI-Kit Lab" và trang /dev/ui-kit dành cho lập trình viên.
# VITE_SHOW_UI_KIT=true
